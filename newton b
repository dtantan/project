import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# newton part b
def white_dwarf_plot(csv_file):

    # read csv file
    df = pd.read_csv(csv_file)

    # constants
    G = 6.67408e-8
    sun_mass   = 1.98847e33
    earth_r = 6.371e8

    # logg convertion
    df['G'] = 10**df['logg']

    # mass convertion
    df['M'] = df['mass'] * sun_mass

    # radius
    df['R'] = np.sqrt(G * df['M'] / df['G'])

    # earth radius
    df['earth_R'] = df['R'] / earth_r

    # Plot M (solar masses) vs. R (Earth radii)
    plt.scatter(df['earth_R'], df['mass'], color='red')
    plt.xlabel('Radius')
    plt.ylabel('Mass')
    plt.title('Mass-Radius of White Dwarfs')
    plt.show()

if __name__ == "__main__":
    white_dwarf_plot("white_dwarf_data.csv")

